{
  "name": "launchpad-registry",
  "version": "0.2.0",
  "description": "Community-maintained registry of token launchpads (program IDs, factories, launch events) across Solana and EVM chains, plus a generic new-launchpad detector.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run validate && npm run build && npm test && git diff --exit-code -- dist docs/index.html || (echo 'dist/docs stale: run npm run build and commit' && exit 1)",
    "test": "node --test test/",
    "verify": "node scripts/verify-onchain.mjs",
    "detect": "node detector/index.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "^1.7.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./dist/*": "./dist/*",
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-DATA",
    "README.md",
    "abi/",
    "detector/",
    "dist/",
    "icons/",
    "idl/",
    "index.d.ts",
    "index.mjs",
    "llms.txt",
    "mcp/",
    "registry/",
    "schema/"
  ],
  "keywords": [
    "solana",
    "evm",
    "launchpad",
    "pump.fun",
    "raydium",
    "meteora",
    "registry",
    "memecoin",
    "sniper",
    "radar",
    "uniswap-v4"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/launchpad-registry.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "bin": {
    "launchpad-registry-mcp": "./mcp/server.mjs",
    "launchpad-detector": "./detector/index.mjs"
  }
}
