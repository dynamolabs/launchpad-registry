{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chain",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "id", "name", "dir"],
  "properties": {
    "family": {
      "enum": ["solana", "evm"]
    },
    "id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "dir": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "registry/<dir>/ holds this chain's launchpads"
    },
    "nativeSymbol": {
      "type": "string"
    },
    "rpc": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "explorer": {
      "type": "string",
      "format": "uri"
    },
    "dexscreenerId": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Addresses the detector must never flag as a launchpad: DEX factories, routers, position managers, AA entrypoints."
    },
    "caip2": {
      "type": "string",
      "pattern": "^[a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
      "description": "CAIP-2 chain id (eip155:4663, solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp)."
    },
    "quoteTokens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Wrapped native / stable / platform quote tokens: when a pool pairs X with one of these, X is the launched token."
    },
    "maxLogRange": {
      "type": "integer",
      "minimum": 1,
      "description": "Largest eth_getLogs block range the public RPC accepts; scripts clamp their chunks to it."
    }
  }
}
